+     cell_specific_noise_sd = 0.15,
+     use_gene_modules = TRUE,
+     n_gene_modules = 6,                 # Programmi di espressione ben definiti
+     module_correlation = 0.8            # Correlazione moderata-alta
+   )
+ )
